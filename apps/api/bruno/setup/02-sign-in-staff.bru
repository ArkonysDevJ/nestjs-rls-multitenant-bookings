meta {
  name: 02 - Sign in as tenant A staff
  type: http
  seq: 2
}

post {
  url: {{supabaseUrl}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{supabaseAnonKey}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{staffAEmail}}",
    "password": "{{staffAPassword}}"
  }
}

script:post-response {
  bru.setEnvVar("staffAToken", res.body.access_token);
}

tests {
  test("received an access token", function () {
    expect(res.body.access_token).to.be.a("string");
  });
}

docs {
  Same pattern as 01-sign-in-owner, for the tenant A staff account.
  Used by the concurrent-overlap-race script (03), which needs a role
  allowed to create bookings.
}
