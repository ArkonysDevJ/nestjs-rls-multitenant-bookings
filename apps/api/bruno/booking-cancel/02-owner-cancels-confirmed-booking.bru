meta {
  name: 02 - Owner cancels a confirmed booking
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/bookings/{{cancelTargetId}}/cancel
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{ownerAToken}}
  x-tenant-id: {{tenantAId}}
}

tests {
  test("cancels the booking", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("cancelTargetId"));
    expect(res.body.status).to.equal("cancelled");
  });
}
