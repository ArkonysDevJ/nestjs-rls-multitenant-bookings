vars {
  baseUrl: http://localhost:3000/v1
  supabaseUrl:
  supabaseAnonKey:
  tenantAId:
  tenantBId:
  resourceAId:
  resourceBId:
  bookingBId:
  ownerAEmail:
  ownerAPassword:
  staffAEmail:
  staffAPassword:
  viewerAEmail:
  viewerAPassword:
  ownerAToken:
  staffAToken:
  viewerAToken:
}

# Empty template. Do not put real values in this file.
#
# For the local Supabase stack, do not fill this by hand: run
#   bash bruno/setup-local.sh
# from apps/api. It creates the users and data on the local stack and writes
# environments/local-stack.bru, which is ignored by Git and is the
# environment to select in Bruno.
#
# To aim the collection at a Supabase project of your own instead, copy this
# file, fill the copy in Bruno's environment editor (project URL, anon or
# publishable key, tenant, resource and booking IDs, and a user per role) and
# keep the copy out of version control. The tokens are filled automatically
# by running the requests in bruno/setup/ once.
#
# The tests create bookings and cancel them. Never point them at the deployed
# demo.
